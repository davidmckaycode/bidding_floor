CREATE TYPE listing_status AS ENUM(
'open',
'closed'
);

########################################

create table listings (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
public_id UUID NOT NULL DEFAULT gen_random_uuid() UNIQUE,

title varchar(300) NOT NULL,
description text NOT NULL,

status listing_status NOT NULL DEFAULT 'open',

created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
end_at TIMESTAMPTZ NOT NULL,

CONSTRAINT valid_end_time CHECK (end_at > created_at)
);

########################################

create TABLE listing_photos (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
public_id UUID NOT NULL DEFAULT gen_random_uuid() UNIQUE,

listing_id BIGINT NOT NULL,
photo_number int NOT NULL,

image_key TEXT NOT NULL,
preview_image_key TEXT,


FOREIGN KEY (listing_id) REFERENCES listings(id) ON DELETE CASCADE,
CHECK (photo_number > 0),
CHECK (photo_number <> 1 OR preview_image_key IS NOT NULL),
UNIQUE (listing_id, photo_number)

);

########################################























########################################

BID

create TABLE bid (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
public UUID NOT NULL DEFAULT gen_random_uuid() UNIQUE,

user_id BIGINT NOT NULL REFERENCES users(id), 
listing_id BIGINT NOT NULL REFERENCES listings(id),

amount numeric(10,2) NOT NULL CHECK(amount > 0),

created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()

);
########################################
Auto Bid

create TABLE auto_bid (
id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
public UUID NOT NULL DEFAULT gen_random_uuid() UNIQUE,

user_id BIGINT NOT NULL REFERENCES users(id), 
listing_id BIGINT NOT NULL REFERENCES listings(id),

max_amount numeric(10,2) NOT NULL CHECK (max_amount > 0),

created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
active boolean NOT NULL DEFAULT TRUE

);

########################################

CREATE UNIQUE INDEX max_one_autobid_active
ON auto_bid (user_id, listing_id)
WHERE active = TRUE;

